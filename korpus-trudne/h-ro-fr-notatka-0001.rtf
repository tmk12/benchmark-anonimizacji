\par \pard\plain \s0\rtlch\af2\afs22\alang1025 \ltrch\lang1033\langfe1033\hich\af9\loch\sl276\slmult1\ql\widctlpar\sb0\sa200\ltrpar\hyphpar0\f9\fs20\cf0\lang1033\kerning0\dbch\af2\langfe1033\sl276\slmult1\sb0\sa120{\loch
